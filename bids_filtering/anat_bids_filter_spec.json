{
    "exact_one_T1w_and_FLAIR" : {
        "description": "Participants who have exactly 1 T1w AND exactly 1 FLAIR anatomical image",
        "scanner_metadata": {
            "sidecar_tags": ["InstitutionName", "Manufacturer", "ManufacturersModelName"]
        },
        "groupby_cols": ["sub", "ses", "suffix"],
        "count_cols": ["acq", "run", "path"],
        "criteria": {
            "scanner_metadata": {},
            "datatypes": {
                "values": ["anat"],
                "match": "AND"
            },
            "suffixes": {
                "values": ["T1w", "FLAIR"],
                "match": "AND"
            },
            "count_spec": {
                "count_operator": "equal_to",
                "rules": [
                    { "suffix": "T1w",   "n_path": 1 },
                    { "suffix": "FLAIR", "n_path": 1 }
                ]
            }
        }
    },

