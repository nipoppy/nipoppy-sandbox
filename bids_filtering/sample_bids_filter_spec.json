    "complete_multi_shell_dwi" : {
        "description": "Participants with only multi-shell dwi data (i.e. acq: not null)",
        "scanner_metadata": {
            "sidecar_tags": ["InstitutionName", "Manufacturer", "ManufacturersModelName", "SeriesDescription"]
        },
        "groupby_cols": ["sub", "ses", "datatype", "acq", "dir"],
        "count_cols": ["run", "path"],
        "criteria": {
            "scanner_metadata": {},
            "datatypes": {
                "values": ["anat", "dwi"],
                "match": "AND"
            },
            "count_spec": {
                "count_operator": "greater_or_equal_to",
                "rules": [
                    { "acq": "B0",    "dir": "AP", "n_run": 4 },
                    { "acq": "B0",    "dir": "PA", "n_run": 1 },
                    { "acq": "B700",  "dir": "PA", "n_run": 1 },
                    { "acq": "B1000", "dir": "PA", "n_run": 1 },
                    { "acq": "B2000", "dir": "PA", "n_run": 1 }
                ]
            }
        }
    },

    "complete_multi_modal_anat" : {
        "description": "Participants who have ALL of T1w AND FLAIR anatomical images (logical AND on suffix)",
        "scanner_metadata": {
            "sidecar_tags": ["InstitutionName", "Manufacturer", "ManufacturersModelName"]
        },
        "groupby_cols": ["sub", "ses", "suffix"],
        "count_cols": ["acq", "run", "path"],
        "criteria": {
            "scanner_metadata": {},
            "datatypes": {
                "values": ["anat"],
                "match": "AND"
            },
            "suffixes": {
                "values": ["T1w", "FLAIR"],
                "match": "AND"
            },
            "count_spec": {
                "count_operator": "greater_or_equal_to",
                "rules": [
                    { "suffix": "T1w",   "n_path": 1 },
                    { "suffix": "FLAIR", "n_path": 1 }
                ]
            }
        }
    }
