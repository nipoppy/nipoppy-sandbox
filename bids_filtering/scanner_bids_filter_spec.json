    "Philips_single_shell_dwi" : {
        "description": "Participants with only single-shell dwi data (i.e. acq: null)",
        "scanner_metadata": {
            "sidecar_tags": ["InstitutionName", "Manufacturer", "ManufacturersModelName", "SeriesDescription"]
        },
        "groupby_cols": ["sub", "ses", "datatype", "dir"],
        "count_cols": ["acq", "run", "path"],
        "criteria": {
            "scanner_metadata": {
                "sidecar_tags": {
                    "Manufacturer": ["Philips"]
                }
            },
            "datatypes": {
                "values": ["anat", "dwi"],
                "match": "AND"
            },
            "count_spec": {
                "count_operator": "equal_to",
                "rules": [
                    { "dir": "LR", "n_acq": 0 },
                    { "dir": "RL", "n_acq": 0 }
                ]
            }
        }
    },

